rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /answers/{answerId} {
        allow read, write: if isOwner(uid);
      }
      match /resumes/{resumeId} {
        allow read, write: if isOwner(uid);
      }
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /answers/{answerId} {
      allow read, create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(uid);
    }

    match /ai_feedback/{feedbackId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
